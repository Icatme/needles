{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icatme.github.io/needles/schemas/playtest-campaign.v1.schema.json",
  "title": "Needles Playtest Campaign v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "purpose",
    "packId",
    "packVersion",
    "pilotTargets",
    "anchors"
  ],
  "properties": {
    "schema": { "const": "needles.playtest-campaign/v1" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "packId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "packVersion": { "type": "string", "minLength": 1 },
    "comparisonPackId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "defaultSkinId": { "type": "string", "minLength": 1 },
    "pilotTargets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attemptsPerLevel", "sourcesPerLevel"],
      "properties": {
        "attemptsPerLevel": { "type": "integer", "minimum": 1 },
        "sourcesPerLevel": { "type": "integer", "minimum": 1 }
      }
    },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["levelId", "order", "reason"],
        "properties": {
          "levelId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "order": { "type": "integer", "minimum": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

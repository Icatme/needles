{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icatme.github.io/needles/schemas/pack-index.v1.schema.json",
  "title": "Needles Pack Index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "defaultPackId", "packs"],
  "properties": {
    "schema": { "const": "needles.pack-index/v1" },
    "defaultPackId": { "$ref": "#/$defs/id" },
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "manifest"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "manifest": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    }
  }
}
